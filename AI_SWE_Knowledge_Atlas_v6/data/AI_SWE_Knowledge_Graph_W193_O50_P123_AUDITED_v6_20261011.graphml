  <data key="d31">The reality of AI-Assisted software engineering productivity</data>
  <data key="d32">practitioner_article</data>
  <data key="d54">CURATED_PRACTITIONER_NOT_RESEARCH</data>
  <data key="d33">Productivity</data>
