  <data key="d36">https://newsletter.pragmaticengineer.com/p/ai-tooling-2026</data>
  <data key="d126">https://newsletter.pragmaticengineer.com/p/ai-tooling-2026</data>
  <data key="d184">https://newsletter.pragmaticengineer.com/p/ai-tooling-2026</data>
  <data key="d131">2026-03-03</data>
  <data key="d252">Canonical article edition date; earlier identified parent-issue date retained separately</data>
  <data key="d253">2026-03-03</data>
  <data key="d254">2026-03-03</data>
