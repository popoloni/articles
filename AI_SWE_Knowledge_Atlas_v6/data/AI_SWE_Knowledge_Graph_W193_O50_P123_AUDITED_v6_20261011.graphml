  <data key="d251">Gergely Orosz</data>
  <data key="d36">https://newsletter.pragmaticengineer.com/p/what-is-happening-with-code-reviews</data>
  <data key="d126">https://newsletter.pragmaticengineer.com/p/what-is-happening-with-code-reviews</data>
  <data key="d184">https://newsletter.pragmaticengineer.com/p/what-is-happening-with-code-reviews</data>
  <data key="d131">2026-09-08</data>
