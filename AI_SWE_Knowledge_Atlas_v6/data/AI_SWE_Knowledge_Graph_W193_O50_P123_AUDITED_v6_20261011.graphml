  <data key="d47"></data>
  <data key="d48"></data>
  <data key="d49"></data>
  <data key="d50"></data>
  <data key="d51"></data>
  <data key="d52"></data>
  <data key="d53"></data>
  <data key="d54">LEGACY_EDITORIAL_GRAPH</data>
  <data key="d55">2026-10-09 corrected editorial crosswalk</data>
  <data key="d56">CH03:NOT_INDEPENDENTLY_INSPECTED; CH07:FULLTEXT_INSTITUTIONAL</data>
  <data key="d57">2</data>
  <data key="d58">Archived self-reported inspection depth; no independent reinspection from these archive records in 2026-10-10 pass.</data>
</node>
