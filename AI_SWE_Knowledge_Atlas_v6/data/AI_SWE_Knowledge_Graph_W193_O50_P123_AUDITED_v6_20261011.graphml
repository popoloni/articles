  <data key="d36">https://newsletter.pragmaticengineer.com/p/how-tech-companies-measure-the-impact-of-ai</data>
  <data key="d126">https://newsletter.pragmaticengineer.com/p/how-tech-companies-measure-the-impact-of-ai</data>
  <data key="d184">https://newsletter.pragmaticengineer.com/p/how-tech-companies-measure-the-impact-of-ai</data>
  <data key="d131">2025-09-16</data>
  <data key="d252">Canonical article edition date; earlier identified parent-issue date retained separately</data>
  <data key="d253">2025-09-16</data>
