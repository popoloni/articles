<node id="O033">
  <data key="d31">The "Trust, But Verify" Pattern For AI-Assisted Engineering</data>
  <data key="d32">practitioner_article</data>
  <data key="d54">CURATED_PRACTITIONER_NOT_RESEARCH</data>
  <data key="d33">Verification &amp; review</data>
  <data key="d34">2025</data>
  <data key="d35">Addy Osmani</data>
  <data key="d36">https://addyo.substack.com/p/the-trust-but-verify-pattern-for</data>
